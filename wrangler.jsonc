{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "devth-com-preview",
  "account_id": "f1ca5a657f85b1dfa8e4ce92a64aa3db",
  "compatibility_date": "2026-10-23",
  "build": { "command": "npm run build" },
  "workers_dev": true,
