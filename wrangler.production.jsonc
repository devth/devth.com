{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devth-com",
  "account_id": "ab80ed3a83c85462eff2a15e7b38a884",
  "main": "production/worker.js",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "preview_urls": false,
  "build": {
    "command": "npm run build:production",
  },
  "routes": [
    {
      "pattern": "devth.com",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/counter.svg"],
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "COUNTERS",
        "class_name": "PageCounter",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PageCounter"],
    },
  ],
}
