{
  "name": "devth.com",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --host 127.0.0.1",
    "build": "vp build",
    "build:production": "node scripts/counter-pages.js && SITE_ENV=production vp build && node scripts/verify-production.js",
    "preview": "vp preview --host 127.0.0.1",
    "test": "vp test run --config vite.test.config.js",
    "check": "vp check",
    "test:browser": "playwright test",
    "test:production": "playwright test --config playwright.production.config.js",
    "deploy:counter": "wrangler deploy --config wrangler.counter.jsonc",
    "deploy": "npm run deploy:counter && wrangler deploy",
    "deploy:production": "wrangler deploy --config wrangler.www.jsonc && wrangler deploy --config wrangler.production.jsonc"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "linkedom": "^0.18.12",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.0.0",
    "shiki": "^4.5.0",
    "three": "^0.186.1",
    "vite-plus": "1.4.0",
    "wrangler": "4.152.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  }
}
